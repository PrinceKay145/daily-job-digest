# ─────────────────────────────────────────────────────────────────────────────
# Local-run credentials. Copy this file to `.env` and fill in the real values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. This file (.env.example)
# is committed on purpose — it only ever holds placeholders.
#
# You do NOT need .env for the scheduled GitHub Actions run. There, the same
# three values are stored as repository secrets instead. See README.md.
# ─────────────────────────────────────────────────────────────────────────────

# The Gmail account that SENDS the digest.
EMAIL_FROM=you@gmail.com

# A Gmail App Password — 16 characters, NOT your normal Google password.
# Get one at https://myaccount.google.com/apppasswords (2-Step Verification
# must be on first). Google shows it as 4 groups of 4; spaces don't matter.
EMAIL_APP_PASSWORD=abcdefghijklmnop

# Where the digest is delivered. Can be the same address as EMAIL_FROM.
EMAIL_TO=princekay145@gmail.com
